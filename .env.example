# ONLY the isolated owner/private signer and setup CLI read this file.
# Never load these into the public app, agent or browser.
NEAR_ACCOUNT_ID=
NEAR_OWNER_PRIVATE_KEY=

# Public service names (configure its environment separately, without owner keys).
LEASH_HOST=127.0.0.1
PORT=3000
LEASH_PUBLIC_ORIGIN=http://127.0.0.1:3000
LEASH_CONFIG_PATH=.runtime/public/native-config.json
LEASH_LEDGER_PATH=.runtime/live-ledger.json
LEASH_AGENT_KEY_DIR=.agent-keys
LEASH_SIGNER_SOCKET=.private-signer/signer.sock
# Agent CLI: scoped token only.
# LEASH_URL=https://YOUR-APP
# LEASH_AGENT_TOKEN=
