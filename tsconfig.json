{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "leash/**/*.ts",
    "contract/**/*.ts",
    "app/**/*.ts",
    "agent-demo/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
